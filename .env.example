# Copiá este archivo a ".env" y completá tus datos antes de arrancar el server.

PORT=3000

# Sesión de admin (cambiá esto por algo largo y random en producción)
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-random

# Usuario y contraseña del panel de administración (/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=cambiaesta123

# Datos que se muestran en el checkout para la transferencia (ya vienen cargados por defecto)
BANK_ALIAS=nalv.estudio
BANK_CVU=0000003100053631202291
BANK_HOLDER=Carlos Nahuel Alvarez
WHATSAPP_NUMBER=5492215730729

# Mail donde te llega el aviso de cada pedido (con los diseños adjuntos)
ORDER_EMAIL=nalvarezestudio@gmail.com

# Para que el sitio pueda ENVIAR ese mail necesita una cuenta de envío.
# Con Gmail: activá la verificación en 2 pasos y creá una "contraseña de aplicación"
# en https://myaccount.google.com/apppasswords (16 letras, sin espacios). NO uses tu clave normal.
# Si dejás esto vacío, el sitio funciona igual y los pedidos quedan en /admin.html.
SMTP_USER=nalvarezestudio@gmail.com
SMTP_PASS=
# (opcional) otro proveedor: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true

# Ajuste de los costos de envío estimados de Correo Argentino, en %.
# 0 = tarifa de lista. Si tenés convenio y pagás menos, poné negativo (ej: -15); si querés cobrar de más, positivo.
SHIPPING_ADJUST_PCT=0

# Nombre de la tienda
STORE_NAME=nalv.estudio


# Dirección del local (la usa el bot TONY y el checkout para el retiro)
LOCAL_ADDRESS=calle 45 e/ 145 y 146
LOCAL_CITY=La Plata

# Dirección pública del sitio (para los links de los mails: recuperar clave y baja de promos)
PUBLIC_URL=http://localhost:3000

# DÓNDE se guardan tus datos (pedidos, clientes, stickers cargados, mail conectado, archivos de pedidos).
# Vacío = se guarda solo en  <tu usuario>/nalv-datos  (fuera del sitio, no se pierde al actualizar).
# Si tu hosting tiene disco persistente, poné acá su ruta. Ejemplos:
#   DATA_DIR=/var/data/nalv          (Render con disco persistente montado en /var/data)
#   DATA_DIR=C:\nalv-datos           (Windows)
#   DATA_DIR=/home/tuusuario/nalv-datos   (VPS / Mac / Linux)
DATA_DIR=
